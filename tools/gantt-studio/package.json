{
  "name": "gantt-studio",
  "version": "1.3.0",
  "description": "跨平台甘特图规划工具",
  "author": {
    "name": "Bertie97",
    "email": "2247501256@qq.com"
  },
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "test": "node --test tests/*.test.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.0",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.ganttstudio.desktop",
    "productName": "Gantt Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Gantt Studio",
      "syncDesktopName": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "icon": "build/icon.png"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://github.com/Bertie97",
  "desktopName": "gantt-studio.desktop"
}
